# Copy to backend/.env and fill in for local development.
# See docs/HANDOFF.md for how to get a long-lived access token from a real HA
# instance, or use compose/dev-ha/ to spin up a throwaway one with demo data.

HIA_HA_URL=http://localhost:8123
HIA_HA_TOKEN=

HIA_LOG_LEVEL=INFO
HIA_LOG_JSON=false
